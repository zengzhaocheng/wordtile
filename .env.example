# 复制为 .env 后按实际情况修改：cp .env.example .env
# .env 已在 .gitignore 中，不会提交到仓库

# —— 数据库（仅容器内网访问，不对外暴露）——
POSTGRES_USER=wordtile
POSTGRES_PASSWORD=请改成随机强密码
POSTGRES_DB=wordtile

# —— 安全：务必替换！生成方式：openssl rand -base64 32 ——
JWT_SECRET=请替换成随机32字节字符串

# —— 访问地址 ——
# 前端访问的域名（用于 Caddy 签发证书，不带 http://）
DOMAIN=wordtile.example.com
# 允许跨域的来源，多个用英文逗号分隔（前后端同源时可不配，但建议保留域名）
CORS_ORIGINS=https://wordtile.example.com
# 前端构建时注入的后端地址；留空表示同源 /api/v1（走 nginx 反代）
VITE_API_URL=
